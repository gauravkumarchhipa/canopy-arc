# Copy to .env.local and fill in from Supabase Dashboard → Connect
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# New projects: publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Legacy projects: anon JWT key (eyJ...) — use one or the other
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Dev mock login (any email/password) — enabled by default in development
# Set AUTH_MOCK=false to require real Supabase auth in dev
# AUTH_MOCK=true
